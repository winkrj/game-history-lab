{
  "name": "game-history-mysql",
  "config": {
    "connector.class": "io.debezium.connector.mysql.MySqlConnector",
    "tasks.max": "1",
    "database.hostname": "mysql",
    "database.port": "3306",
    "database.user": "debezium",
    "database.password": "debezium",
    "database.server.id": "184054",
    "topic.prefix": "game-history",
    "database.include.list": "game_history_lab",
    "table.include.list": "game_history_lab.games,game_history_lab.rounds,game_history_lab.round_scores",
    "snapshot.mode": "no_data",
    "include.schema.changes": "false",
    "schema.history.internal.kafka.bootstrap.servers": "kafka:9092",
    "schema.history.internal.kafka.topic": "game-history-schema-history",
    "schema.history.internal.store.only.captured.tables.ddl": "true",
    "tombstones.on.delete": "false"
  }
}
