# Render with:
# d2 --theme=4 --pad=32 \
#   docs/diagrams/read-model-operations.d2 \
#   docs/diagrams/read-model-operations.svg

grid-rows: 3
grid-columns: 6
grid-gap: 28

classes: {
  spacer: {
    label: ""
    width: 120
    height: 60
    style.opacity: 0
  }
}

# Bulk / recovery lane
spacer_1.class: spacer
batch: Spring Batch\nBulk / recovery
spacer_2.class: spacer
spacer_3.class: spacer
spacer_4.class: spacer
spacer_5.class: spacer

# Shared endpoints
source: MySQL\nSource of truth {
  shape: cylinder
}
spacer_6.class: spacer
spacer_7.class: spacer
spacer_8.class: spacer
read_model: Read Model\nQuery data {
  shape: cylinder
}
api: History API

# Continuous update lane
spacer_9.class: spacer
debezium: Debezium
kafka: Kafka {
  shape: queue
}
consumer: Consumer
updater: Projection updater\nRe-read source
spacer_10.class: spacer

source -> batch: initial · rebuild · repair
batch -> read_model: UPSERT

source -> debezium: binlog
debezium -> kafka
kafka -> consumer
consumer -> updater
updater -> read_model: UPSERT

read_model -> api: query
